.ipynb_checkpoints/
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.tmp
_*.py
_*.json
# ...but never ignore package __init__.py files (they start with underscore)
!**/__init__.py
netsec_upload_*.pcapng
# User captures placed alongside the repo for interactive analysis -
# never checked in (they are the user's data, not the project's).
/new*.pcap
/new*.pcapng

# Hebrew documentation versions - kept locally, English-only in the repo.
# Explicit exceptions for docs the user has approved for the shared repo.
*_HE.md
*_he.mmd
*_he.dot
*_he.png
!docs/DOCKER_AI_AGENTS_HE.md
!docs/VM_ARCHITECTURE_HE.md
!docs/VM_BOOTSTRAP_HE.md
!docs/DATA_ENGINEERING_HE.md

# local working backups created by tooling
*.local-bak

# Live recording output directory (per-session PCAPs land here)
netsec_sessions/

# Editor / tooling settings that must never be tracked
settings.local.json
.vscode/
.idea/
anaconda_projects/

# pytest cache (created by running tests/)
.pytest_cache/

# LLM judge runtime artifacts (optional add-on; see llm_judge/README.md)
llm_judge/cache/
llm_judge/output/

# Local Docker automation stack (n8n + judge_api FastAPI) - contains secrets,
# runtime volumes, DBs and workflow templates. Never committed.
automation/

# PCAPs moved out of incoming/ after successful triage. Local-only.
processed/

# Advanced-engine real captures too large or research-licensed to commit -
# fetched on demand by attack_tests/advanced/fetch.py into this cache.
attack_tests/advanced/_cache/

# Runtime stdout/stderr logs from launching the dashboard / judge_api locally.
*.log

# Local deployment secrets (see deploy/README.md) - never committed.
deploy/.env
