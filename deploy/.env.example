# Copy to deploy/.env and fill in. deploy/.env is gitignored - secrets
# live only there. Every variable the stack reads is listed here with its
# code default; you only need to change the ones relevant to your setup.
# Inline "KEY=value  # comment" is avoided on purpose - some .env parsers
# keep the comment as part of the value. Comments live on their own line.

# ==================================================================
#  Core
# ==================================================================
# The VM's Tailscale IP. Every published service binds to it (IDX-08).
# Leave 127.0.0.1 only for a local smoke test.
TS_BIND=127.0.0.1
# Data root. On the 100 GB Always Free boot volume this stays on the boot
# disk (no extra volume needed - stays $0). Retention keeps it bounded.
NETSEC_DATA_ROOT=/srv/netsec
# History DB path. Defaults to $NETSEC_DATA_ROOT/db/netsec.db.
NETSEC_DB=
TZ=UTC

# ==================================================================
#  n8n
# ==================================================================
# Any long random string. Credentials exported from another n8n import
# cleanly ONLY if this key matches (see docs/VM_DEPLOYMENT.md).
N8N_ENCRYPTION_KEY=
# Hostname n8n advertises for webhooks. Usually the VM's Tailscale IP.
N8N_HOST=

# ==================================================================
#  Dashboard -> VM upload button
# ==================================================================
# The dashboard's "Send S1/S2 to VM (mail report)" button signs the PCAP
# and streams it to /v1/pcap on the analyzer VM (spec 5.1). Set
# NETSEC_INGEST_URL below, plus NETSEC_SENSOR_ID / NETSEC_SENSOR_SECRET
# from deploy/create_sensor.py. NETSEC_REMOTE_HOST is kept as a shortcut:
# when set, NETSEC_INGEST_URL defaults to http://<host>:8766.
NETSEC_REMOTE_HOST=
# Optional: highlight one device in the per-device profile view. Blank =
# auto-pick the busiest local device in each capture.
NETSEC_MY_DEVICE_IP=

# ==================================================================
#  Ingest API (primary upload path)
# ==================================================================
# HTTP upload replaces scp as the primary path (spec 5.1). Create the
# sensor credentials with: python3 deploy/create_sensor.py <name>
# e.g. NETSEC_INGEST_URL=http://<vm-tailscale-ip>:8766
NETSEC_INGEST_URL=
NETSEC_SENSOR_ID=
NETSEC_SENSOR_SECRET=
# Bearer token for read endpoints (/v1/sessions, /v1/reports) - dashboard
# remote-viewing client only.
NETSEC_API_TOKEN=
# Single-file upload ceiling (GB). Rejects an oversized upload per chunk.
NETSEC_MAX_UPLOAD_GB=10
# HMAC anti-replay window in seconds (clock skew tolerance). Requires NTP.
NETSEC_HMAC_WINDOW_S=300

# ==================================================================
#  Worker
# ==================================================================
# Declared infrastructure destinations (comma-separated IPs) for the
# telemetry reconciliation of spec section 12.2 - typically the VM's
# Tailscale IP. Empty disables reconciliation. Must match the sensor's
# NETSEC_INFRA_DSTS for the cross-check to line up.
NETSEC_INFRA_DSTS=
# Worker queue poll interval (seconds).
NETSEC_POLL_S=10
# A running job older than this (seconds) is treated as crashed and
# requeued.
NETSEC_STALE_RUNNING_S=3600
# Recorded on each session row for provenance; free-form label.
NETSEC_PIPELINE_VERSION=
# Fallback recipient when an upload arrives without X-Notify-Email
# (dashboard button, tools/upload_pcap.py --email). Per-session address
# ALWAYS wins; this is for the solo-operator setup where every capture
# should hit the same inbox regardless of who submitted it.
NETSEC_NOTIFY_EMAIL=
# Delivery fallback: when SMTP fails the worker POSTs a JSON payload
# here so a user-owned n8n workflow (Gmail node, Discord, Slack) can
# pick up the report. Empty = no fallback (SMTP failures logged only).
N8N_WEBHOOK_URL=

# ==================================================================
#  Baseline (per-device history)
# ==================================================================
# Rolling window (days) of prod sessions used to build per-device
# baselines and now-vs-history comparisons.
BASELINE_WINDOW_DAYS=30

# ==================================================================
#  Retention (decisions IDX-01..04)
# ==================================================================
RETENTION_PCAP_DAYS=7
RETENTION_WATERMARK_PCT=85
KEEP_FIELDS_FOREVER=1
RETENTION_INTERVAL_S=86400
RETENTION_BACKUP_KEEP=14
# Optional dead-man's-switch URL (e.g. healthchecks.io) pinged after each
# successful retention cycle - silence means the VM is in trouble.
NETSEC_HEARTBEAT_URL=

# ==================================================================
#  Sensor (capture agent) - only if you run sensor/capture_agent.py
# ==================================================================
# Interface to capture on (or pass --interface). No default - required.
NETSEC_CAPTURE_IFACE=
# Where ring-buffer chunks + the spool directory live. Defaults to
# $NETSEC_DATA_ROOT/capture.
NETSEC_CAPTURE_DIR=
# Ring-buffer chunk duration (seconds) and file count (~24h at 96*900s).
NETSEC_CHUNK_SECONDS=900
NETSEC_RING_FILES=96
# Spool ceiling (GB) before the oldest un-uploaded chunk is dropped and a
# gap record is written.
NETSEC_SPOOL_CAP_GB=20
# prod | test - test captures never feed baselines (IDX-11).
NETSEC_SESSION_KIND=prod
# Local signed telemetry manifest path. Defaults to ~/.netsec/telemetry.jsonl.
NETSEC_MANIFEST=

# ==================================================================
#  External watchdog - only if you run tools/watchdog.py (off-box)
# ==================================================================
# The /healthz URL to probe, e.g. http://<vm-tailscale-ip>:8766/healthz.
WATCHDOG_URL=
WATCHDOG_EMAIL=
WATCHDOG_INTERVAL_S=300
WATCHDOG_FAILURES=3
WATCHDOG_HEARTBEAT_URL=

# ==================================================================
#  LLM judge - core knobs
# ==================================================================
# Master switch. 0/false disables judging (detection still runs).
LLM_JUDGE_ENABLED=1
# claude | ollama | openai_compat (see llm_judge/judge_config.py).
# NOTE: the zero-API-key path is LLM_JUDGE_PROVIDER=ollama with a local
# Ollama daemon - every user can get a full verdict with no keys at all.
LLM_JUDGE_PROVIDER=openai_compat
# Model id used when provider is claude.
LLM_JUDGE_MODEL=claude-opus-4-8
# claude reasoning effort: low | medium | high.
LLM_JUDGE_EFFORT=medium
# Max output tokens per verdict.
LLM_JUDGE_MAX_TOKENS=8192
# Per-request timeout (seconds). The Actions workflow overrides to 600.
LLM_JUDGE_TIMEOUT_S=300
# Force a fired-rule candidate to at least "suspicious" (1 = on).
LLM_JUDGE_RULE_GUARDRAIL=1
# Max candidates judged per capture (rule-triggered always survive).
LLM_JUDGE_MAX_CANDIDATES=40
# openai_compat provider (Groq shown; any OpenAI-compatible host works).
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
OPENAI_COMPAT_API_KEY=
# Local Ollama (the free, no-key judge).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Anthropic (only if provider is claude).
ANTHROPIC_API_KEY=

# ==================================================================
#  LLM judge - panel / committee / debate
# ==================================================================
# Two-judge committee (legacy; the panel supersedes it). 0 = off.
LLM_JUDGE_COMMITTEE=0
LLM_JUDGE_COMMITTEE_MODEL_B=llama-3.1-8b-instant
# Panel debate round when judges disagree. 1 = on.
LLM_JUDGE_DEBATE=1
# How a split panel resolves (SCIENTIFIC_AUDIT 3.2).
#   majority  - a strict majority (>50%) of valid judges picks the label;
#               with no majority, the most severe side wins AND the
#               candidate is flagged needs_human_review. One hallucinating
#               judge cannot outvote two peers.
#   fail-safe - the most severe label always wins on any split (the
#               pre-v0.5 paranoid default).
LLM_JUDGE_PANEL_QUORUM=majority
# Narrow escape hatch for the rule guardrail (SCIENTIFIC_AUDIT 3.1).
# 1 = a benign verdict at confidence >= 0.85 that cites whitelisted
# evidence (public resolver / anycast / known cloud provider) is allowed
# through instead of being escalated to suspicious; every bypass is
# recorded as guardrail_bypassed for audit. 0 = every benign-on-fired-rule
# is overridden, no exceptions.
LLM_JUDGE_GUARDRAIL_ESCAPE=1
# Candidates packed into ONE call during the panel's initial round.
# 1 = off (per-candidate calls).
#
# Size it from arithmetic, not taste. Measured 2026-08:
#   system prompt  ~1 675 tokens  (paid ONCE per call, whatever n is)
#   candidate blob   ~720 tokens  (paid per candidate)
#   request cost = 1675 + n x 720
# Against Groq's free per-minute ceilings (6 000 for llama-3.1-8b-instant,
# 8 000 for the gpt-oss models):
#   n=1 -> 2 395 tok/call, 33 candidates = 79 000 tokens per judge
#   n=3 -> 3 835 tok/call, fits the 6k window with room to spare,
#          33 candidates = 42 000 tokens per judge (47% cheaper than n=1)
#   n=5 -> 5 275 tok/call, 88% of the whole 6k minute in one request:
#          any concurrent call throttles it, and the batch falls back to
#          the per-candidate path it was meant to replace
# So n=3 is the sweet spot on that tier; the safe default stays 1.
LLM_JUDGE_BATCH_SIZE=1
# CI calibration gate on category kappa.
LLM_JUDGE_KAPPA_THRESHOLD=0.60
# Optional: point usage counters at a DB to watch free-tier limits
# (informational only; nothing is auto-skipped).
LLM_JUDGE_QUOTA_DB=

# ==================================================================
#  LLM endpoint profiles (decision IDX-05)
# ==================================================================
# Named profiles let one panel mix several OpenAI-compatible hosts.
# Verify each provider's current free-tier limits at setup - they move.
LLM_JUDGE_EP_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_JUDGE_EP_GROQ_KEY_ENV=GROQ_API_KEY
LLM_JUDGE_EP_GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

LLM_JUDGE_EP_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_JUDGE_EP_GEMINI_KEY_ENV=GEMINI_API_KEY
LLM_JUDGE_EP_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

LLM_JUDGE_EP_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
LLM_JUDGE_EP_CEREBRAS_KEY_ENV=CEREBRAS_API_KEY
LLM_JUDGE_EP_CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_API_KEY=

LLM_JUDGE_EP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_JUDGE_EP_OPENROUTER_KEY_ENV=OPENROUTER_API_KEY
LLM_JUDGE_EP_OPENROUTER_MODEL=deepseek/deepseek-r1:free
OPENROUTER_API_KEY=

LLM_JUDGE_EP_GITHUB_BASE_URL=https://models.github.ai/inference
LLM_JUDGE_EP_GITHUB_KEY_ENV=GITHUB_MODELS_TOKEN
LLM_JUDGE_EP_GITHUB_MODEL=gpt-4o-mini
GITHUB_MODELS_TOKEN=

# Which judges run - YOUR choice. List one, two, or many; every judge in
# the panel runs and ALL verdicts come back (there is no fallback that
# silently swaps models). A judge that errors is reported, not replaced.
# The default below mixes three families (IDX-06) and needs a Groq key, a
# Gemini key, and a local Ollama. For a zero-key run, use just:
#   LLM_JUDGE_PANEL=ollama:qwen2.5:14b,ollama:phi4:14b
# or drop the panel entirely and set LLM_JUDGE_PROVIDER=ollama above.
# For a Groq-only two-judge panel (needs one Groq key, each model has its
# own 100k-token/day free quota so a single-model 429 does not kill both):
#   LLM_JUDGE_PANEL=groq:llama-3.1-8b-instant,groq:llama-3.3-70b-versatile
# For 2 Groq + one small local Ollama (adds a zero-key second opinion; the
# panel wall-clock jumps to ~55s per candidate on ARM CPU-only - the Ollama
# call dominates):
#   LLM_JUDGE_PANEL=groq:llama-3.1-8b-instant,groq:llama-3.3-70b-versatile,ollama:qwen2.5:3b
# Avoid on Groq: allam-2-7b returns json_validate_failed even in json_object
# mode (server-side issue - Groq's rendered JSON is malformed). The panel
# tolerates broken judges - permanent 4xx skip the retry loop and do not
# stall parallel judges - but a judge that always fails contributes nothing.
# Avoid on Ollama-CPU: llama3.2:3b hallucinates on scan-rule candidates
# (says benign when the deterministic rule fired). Guardrail overrides it,
# but you paid ~55s for a vote that never lands. qwen2.5:3b is the accurate
# small model at this size on ARM.
LLM_JUDGE_PANEL=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash,ollama:qwen2.5:14b

# ==================================================================
#  OSINT enrichment (optional - fully off without keys)
# ==================================================================
# Wigle locates a captured BSSID (geo map); Shodan rates an external
# peer's reputation, activating the judge's threat-intel weight (W_TI).
# Absent these, the map stays empty and W_TI contributes 0 - nothing
# else changes.
WIGLE_API_NAME=
WIGLE_API_TOKEN=
# Alternative single-value form: "name:token".
WIGLE_API_KEY=
SHODAN_API_KEY=
# 1 enables Shodan lookups of external peers. Keep on its own line.
NETSEC_ENABLE_SHODAN=0
NETSEC_SHODAN_MAX_PEERS=5
# Cache TTLs (days) for enrichment lookups.
WIGLE_TTL_DAYS=30
SHODAN_TTL_DAYS=7

# ==================================================================
#  Dashboard local options
# ==================================================================
# 1 enables reverse-DNS lookups during analysis (off by default - it
# generates PTR traffic on the monitored network).
NETSEC_ENABLE_RDNS=0
# Override the directory the dashboard resolves JSON config files from.
NETSEC_APP_DIR=
# Explicit tshark path override (else PATH + Wireshark install dirs).
TSHARK=

# ==================================================================
#  Email delivery (llm_judge/send_report.py, tools/watchdog.py)
# ==================================================================
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
