## NetSec Caddy - single-auth entry point for the whole stack.
#
# Listens on the VM's Tailscale IP (443 = HTTPS with a Caddy-internal
# self-signed cert). Everything behind it needs the ONE basicauth
# credential; the browser caches it for the browser session, so it is
# a single sign-on across all four apps.
#
# Routes (order matters - specific paths win over the catch-all):
#   /rag/   -> the RAG chat  (host 5200)
#   /chat/  -> the Companion (host 5100)
#   /       -> the portal    (host 8080 - static, no base-path config)
#
# NOT proxied (each has its own auth or is defense-in-depth):
#   :5678 n8n          keeps its own owner-account login; visits go to
#                      https://netsec-agent:5678 with n8n's UI login.
#   :8766 ingest API   HMAC-signed uploads; only the dashboard client.
#   :22   SSH          still on the public interface, out of scope now.
#
# ${BASIC_AUTH_USER} / ${BASIC_AUTH_HASH} come from
# /etc/default/netsec-caddy on the host (mounted via env_file in compose).
# Never in git; the hash is bcrypt of the plaintext.

{
    # Do not try to fetch a public CA cert; we use tls internal for the
    # Tailscale-only site.
    auto_https disable_redirects
    admin off
    email disabled
    # Fall-back SNI: clients that connect by raw IP do not send an SNI
    # extension (RFC 6066: SNI is for hostnames), so Caddy would not
    # know which cert to serve. Point them at netsec-agent, which is
    # the primary internal name.
    default_sni netsec-agent
}

# One site, three names.
# The FQDN (netsec-agent.tail37ac21.ts.net) is what the real
# Let's Encrypt cert from Tailscale covers - browsers show the green
# lock. The IP and short-name still route to the same site (basicauth
# and reverse-proxy rules apply) but Caddy falls back to its internal
# CA for them (short name / IP-based access shows a one-time warning).
netsec-agent.tail37ac21.ts.net {
    tls /etc/netsec-tls/netsec-agent.tail37ac21.ts.net.crt /etc/netsec-tls/netsec-agent.tail37ac21.ts.net.key

    # One credential, one realm. Browsers cache it across paths on the
    # same origin, so the user authenticates once per browser session.
    basicauth * {
        {env.BASIC_AUTH_USER} {env.BASIC_AUTH_HASH}
    }

    log {
        output stdout
        format console
    }

    # Upstreams: the apps bind to the Tailscale IP (100.68.246.54:xxxx)
    # so Caddy proxies straight to it. host.docker.internal would only
    # reach the docker bridge, which the apps do NOT listen on.

    # /rag/ -> the retrieval-augmented chat.
    # handle_path strips the prefix, so the backend sees /
    # (the RAG's inline JS was updated to use relative fetch("ask")).
    handle_path /rag/* {
        reverse_proxy 100.68.246.54:5200
    }

    # /chat/ -> the Companion.
    # companion.py --url-base=/chat/ sets Dash url_base_pathname so
    # assets and callbacks are all prefixed correctly. We use `handle`
    # (not handle_path) so the prefix reaches Dash intact.
    handle /chat/* {
        reverse_proxy 100.68.246.54:5100
    }

    # Catch-all: the static portal.
    handle {
        reverse_proxy 100.68.246.54:8080
    }
}
