%%{init: {'theme':'dark', 'flowchart':{'curve':'basis'}}}%%
flowchart TD
    classDef data fill:#0b3d3a,stroke:#39d0c4,color:#d7fffb
    classDef choose fill:#1b2a4a,stroke:#6aa3ff,color:#dbe8ff
    classDef reject fill:#3a1320,stroke:#ff6a8a,color:#ffd7e0,stroke-dasharray:4 3
    classDef win fill:#2a2440,stroke:#b08bff,color:#efe8ff
    classDef eval fill:#3a2f10,stroke:#e0b020,color:#fff3c9

    D0["<b>קלט גולמי: Wireshark PCAP — S1 ו-S2</b><br/>לכידת פקטות מרשת מקומית חיה.<br/>אין נתונים מתויגים (no labels)."]:::data

    DL1{"<b>דילמה 1: מפוקח או לא-מפוקח?</b><br/>אין תיוג של מתקפות בנתונים."}:::choose
    R1["<b>נדחה: Random Forest / XGBoost / SVM</b><br/>דורשים נתונים מתויגים שאין לנו."]:::reject
    C1["<b>נבחר: למידה לא-מפוקחת</b><br/>זיהוי אנומליות ללא תיוג."]:::win

    DL2{"<b>דילמה 2: אילו מזהים?</b><br/>למודל בודד יש נקודות עיוורון."}:::choose
    C2["<b>נבחר: שילוב 3 מודלים</b><br/>IsolationForest (outliers גלובליים) +<br/>DBSCAN (צפיפות) + LSTM (זמני).<br/>הצלבה דרך מטריצת הסכמה."]:::win

    DL3["<b>הכנת פיצ'רים</b><br/>7 פיצ'רים פר-IP: mean_len, std_len, count,<br/>burst_score, unique_dsts, syn_count, rst_count.<br/><b>StandardScaler</b> — המודלים רגישים לסקאלה."]:::choose

    DL4{"<b>דילמה 3: contamination ל-IsolationForest?</b>"}:::choose
    R4["<b>נדחה: contamination קבוע</b><br/>ניחוש שגוי מסמן יותר/פחות מדי."]:::reject
    C4["<b>נבחר: sweep רגישות [0.05, 0.10, 0.15]</b><br/>בוחרים את הכי קיצוני סטטיסטית.<br/>n_estimators=200, random_state=42."]:::win

    DL5{"<b>דילמה 4: eps ל-DBSCAN?</b>"}:::choose
    R5["<b>נדחה: eps קבוע =0.5</b><br/>לכל סשן סקאלת מרחקים שונה."]:::reject
    C5["<b>נבחר: אוטומטי ממרפק k-distance</b><br/>מרפק לפי נגזרת שנייה. S1=0.78, S2=4.86."]:::win

    DL6{"<b>דילמה 5: min_samples ל-DBSCAN?</b>"}:::choose
    R6["<b>נדחה: min_samples &ge; 3</b><br/>ב-7 ממדים עם ~50–220 IP הכל הופך ל-noise."]:::reject
    C6["<b>נבחר: min_samples=2</b><br/>cluster = -1 פירושו IP בודד = אנומליה."]:::win

    DL7{"<b>דילמה 6: דגימת רצפים ל-LSTM?</b>"}:::choose
    R7["<b>נדחה: step-sampling</b><br/>שובר את הרציפות הזמנית (Fix Issue 8)."]:::reject
    C7["<b>נבחר: רצפים רציפים</b><br/>SEQ_LEN=10, hidden=64, Adam lr=0.001, MSELoss."]:::win

    DL8{"<b>דילמה 7: בסיס לשגיאת LSTM?</b>"}:::choose
    R8["<b>נדחה: שגיאה על סט האימון</b><br/>אופטימי, מסתיר overfit (Fix Issue 1)."]:::reject
    C8["<b>נבחר: סט ולידציה (20%)</b><br/>סימון כששגיאה &gt; val_mean + 2&sigma;.<br/>Early stopping, PATIENCE=2."]:::win

    EV["<b>הערכה ללא labels</b><br/>Silhouette (DBSCAN) + Hopkins statistic +<br/>מטריצת הסכמה IsolationForest↔DBSCAN."]:::eval

    CLS["<b>סיווג מכשירים</b><br/>3 שכבות: hostname/OUI/port → טביעת DNS →<br/>היוריסטיקה התנהגותית (12 קטגוריות)."]:::choose
    SEC["<b>זיהוי איומים</b><br/>ML + שכבות חוקים דטרמיניסטיות:<br/>סריקת/הצפת SYN, ARP-spoof, DNS-tunnel."]:::choose
    OUT["<b>דאשבורד אינטראקטיבי (Dash)</b><br/>השוואת S1 מול S2, עשרות גרפים."]:::win

    D0 --> DL1
    DL1 -.-> R1
    DL1 --> C1 --> DL2
    DL2 --> C2 --> DL3 --> DL4
    DL4 -.-> R4
    DL4 --> C4 --> DL5
    DL5 -.-> R5
    DL5 --> C5 --> DL6
    DL6 -.-> R6
    DL6 --> C6 --> DL7
    DL7 -.-> R7
    DL7 --> C7 --> DL8
    DL8 -.-> R8
    DL8 --> C8 --> EV --> CLS --> SEC --> OUT
