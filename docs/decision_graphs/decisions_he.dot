digraph NetSecDecisions {
    rankdir=TB;
    bgcolor="#0b0a14";
    node [fontname="Helvetica", shape=box, style="rounded,filled", fontcolor="#e8e4f5", penwidth=1.4];
    edge [fontname="Helvetica", color="#9b94b8", fontcolor="#9b94b8"];

    node [fillcolor="#0b3d3a", color="#39d0c4"];
    D0  [label="קלט גולמי: Wireshark PCAP — S1 ו-S2\nלכידה מרשת חיה · אין נתונים מתויגים"];

    node [fillcolor="#1b2a4a", color="#6aa3ff"];
    Q1 [label="דילמה 1: מפוקח מול לא-מפוקח?"];
    Q2 [label="דילמה 2: אילו מזהים?"];
    FP [label="הכנת פיצ'רים: 7 פר-IP + StandardScaler\n(המודלים רגישים לסקאלה)"];
    Q3 [label="דילמה 3: contamination ל-IsolationForest?"];
    Q4 [label="דילמה 4: eps ל-DBSCAN?"];
    Q5 [label="דילמה 5: min_samples ל-DBSCAN?"];
    Q6 [label="דילמה 6: דגימת רצפים ל-LSTM?"];
    Q7 [label="דילמה 7: בסיס לשגיאת LSTM?"];

    node [fillcolor="#3a1320", color="#ff6a8a", style="rounded,filled,dashed"];
    R1 [label="נדחה: Random Forest / XGBoost / SVM\n(דורשים labels)"];
    R3 [label="נדחה: contamination קבוע"];
    R4 [label="נדחה: eps קבוע =0.5"];
    R5 [label="נדחה: min_samples >= 3\n(הכל הופך ל-noise ב-7 ממדים, מעט IP)"];
    R6 [label="נדחה: step-sampling\n(שובר רציפות זמנית)"];
    R7 [label="נדחה: שגיאה על סט האימון\n(מסתיר overfit)"];

    node [fillcolor="#0b3d3a", color="#39d0c4", style="rounded,filled"];
    C1 [label="נבחר: למידה לא-מפוקחת"];
    C2 [label="נבחר: שילוב\nIsolationForest + DBSCAN + LSTM"];
    C3 [label="נבחר: sweep [0.05, 0.10, 0.15]\nn_estimators=200, random_state=42"];
    C4 [label="נבחר: מרפק k-distance (אוטומטי)\nS1=0.78 · S2=4.86"];
    C5 [label="נבחר: min_samples=2\n(-1 = IP בודד = אנומליה)"];
    C6 [label="נבחר: רצפים רציפים\nSEQ_LEN=10, hidden=64, Adam lr=0.001"];
    C7 [label="נבחר: ולידציה 20%\nסימון > val_mean + 2σ, early stopping"];

    node [fillcolor="#3a2f10", color="#e0b020"];
    EV  [label="הערכה ללא labels\nSilhouette + Hopkins + מטריצת הסכמה"];
    node [fillcolor="#2a2440", color="#b08bff"];
    CLS [label="סיווג מכשירים (3 שכבות)\nOUI/port -> טביעת DNS -> היוריסטיקה"];
    SEC [label="זיהוי איומים\nML + שכבות חוקים (SYN scan, ARP-spoof, DNS-tunnel)"];
    OUT [label="דאשבורד אינטראקטיבי (Dash)\nהשוואת S1 מול S2"];

    D0 -> Q1;
    Q1 -> R1 [label="נדחה", style=dashed, color="#ff6a8a"];
    Q1 -> C1 [label="נבחר", color="#39d0c4"];
    C1 -> Q2 -> C2 -> FP -> Q3;
    Q3 -> R3 [style=dashed, color="#ff6a8a"];
    Q3 -> C3 [color="#39d0c4"];
    C3 -> Q4;
    Q4 -> R4 [style=dashed, color="#ff6a8a"];
    Q4 -> C4 [color="#39d0c4"];
    C4 -> Q5;
    Q5 -> R5 [style=dashed, color="#ff6a8a"];
    Q5 -> C5 [color="#39d0c4"];
    C5 -> Q6;
    Q6 -> R6 [style=dashed, color="#ff6a8a"];
    Q6 -> C6 [color="#39d0c4"];
    C6 -> Q7;
    Q7 -> R7 [style=dashed, color="#ff6a8a"];
    Q7 -> C7 [color="#39d0c4"];
    C7 -> EV -> CLS -> SEC -> OUT;
}
