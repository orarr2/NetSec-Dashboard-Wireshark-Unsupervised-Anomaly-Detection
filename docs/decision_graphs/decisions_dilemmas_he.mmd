graph LR
    classDef q fill:#1b2a4a,stroke:#6aa3ff,color:#dbe8ff
    classDef no fill:#3a1320,stroke:#ff6a8a,color:#ffd7e0,stroke-dasharray:4 3
    classDef yes fill:#0b3d3a,stroke:#39d0c4,color:#d7fffb

    ROOT(["פרויקט NetSec — דילמות מרכזיות"]):::q

    ROOT --> Q1{"ש1<br/>מפוקח מול<br/>לא-מפוקח?"}:::q
